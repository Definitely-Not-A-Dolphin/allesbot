{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A src/index.ts",
    "dev-watch": "deno run -A --watch src/index.ts",
    "dev-db": "rm db/db.db; deno run -A src/db.ts; deno run dev",
    "dev-db-watch": "rm db/db.db; deno run -A src/db.ts; deno run dev-watch"
  },
  "imports": {
    "$src/": "./src/",
    "$utils/": "./src/utils/",
    "$static/": "./static/",

    "@db/sqlite": "jsr:@db/sqlite@^0.12.0",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.6",
    "discord.js": "npm:discord.js@^14.25.1",
    "dotenv": "npm:dotenv@^17.3.1", // Only needed because of legacy dotenv parsing
    "zod": "npm:zod@^4.3.6" // This one too
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": [
        "camelCase",
        "eqeqeq",
        "explicit-function-return-type",
        "no-const-reassign",
        "no-eval"
      ],
      "exclude": ["no-extra-non-null-assertion"]
    }
  }
}
